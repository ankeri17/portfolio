---
// Card for a work entry (BRAND.md section 7: cards are only for work
// entries). Used on the Home page (Selected work) and the Work page.
// Entries with a case study link through to /work/<id>/. Entries without
// one (in-progress work) render as a plain card with no link, labeled so
// it never reads as finished.
//
// The image slot shows the entry's artwork from `image`, `imageAlt`,
// `imageWidth`, and `imageHeight` in its frontmatter, through ArtImage.
// See docs/IMAGE_MANIFEST.md for what each image is.
import ArtImage from './ArtImage.astro';

interface Props {
  id: string;
  title: string;
  kind: string;
  summary: string;
  years?: string;
  status?: 'complete' | 'in-progress';
  caseStudy?: boolean;
  category?: 'programs' | 'websites';
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  link?: string;
  wide?: boolean;
  headingLevel?: 'h2' | 'h3';
}

const {
  id,
  title,
  kind,
  summary,
  years,
  status = 'complete',
  caseStudy = true,
  category,
  image,
  imageAlt,
  imageWidth = 1280,
  imageHeight = 800,
  link,
  wide = false,
  headingLevel = 'h3',
} = Astro.props;

const href = `/work/${id}/`;
const Heading = headingLevel;
const meta = status === 'in-progress' ? 'In progress' : years;
---

<article class:list={['work-card', { wide, static: !caseStudy }]} id={id}>
  {caseStudy ? (
    <a class="card-link" href={href}>
      <div class="shot">
        {image ? (
          <ArtImage src={image} alt={imageAlt ?? ''} width={imageWidth} height={imageHeight} fit="cover" sizes="(min-width: 768px) 340px, 100vw" />
        ) : null}
      </div>
      <div class="card-body">
        <p class="eyebrow">
          {kind}
          {meta && <span class:list={['meta', { 'in-progress': status === 'in-progress' }]}> · {meta}</span>}
        </p>
        <Heading class="card-title">{title}</Heading>
        <p class="summary">{summary}</p>
        <p class="more">View case study</p>
      </div>
    </a>
  ) : (
    <div class="card-link">
      <div class="shot">
        {image ? (
          <ArtImage src={image} alt={imageAlt ?? ''} width={imageWidth} height={imageHeight} fit="cover" sizes="(min-width: 768px) 340px, 100vw" />
        ) : null}
      </div>
      <div class="card-body">
        <p class="eyebrow">
          {kind}
          {meta && <span class:list={['meta', { 'in-progress': status === 'in-progress' }]}> · {meta}</span>}
        </p>
        <Heading class="card-title">{title}</Heading>
        <p class="summary">{summary}</p>
        {link && <p class="more"><a href={link}>{link.replace(/^https?:\/\//, '')}</a></p>}
      </div>
    </div>
  )}
</article>

<style>
  .work-card {
    background: var(--paper);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    overflow: hidden;
    transition: border-color var(--transition);
  }

  .work-card:not(.static):hover {
    border-color: color-mix(in srgb, var(--ink) 20%, transparent);
  }

  .card-link {
    display: block;
    height: 100%;
    color: var(--ink);
  }

  .card-link:hover {
    text-decoration: none;
  }

  .card-link:focus-visible {
    outline-offset: -2px;
  }

  /* 4:3 matches the custom artwork's native ratio, so those crop barely at
     all; the 16:10 SVG illustrations lose a little at the sides. */
  .shot {
    aspect-ratio: 4 / 3;
    background: var(--panel);
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-16);
    text-align: center;
  }

  .shot:has(img) {
    padding: 0;
  }

  .card-body {
    padding: var(--space-24);
  }

  .meta.in-progress {
    color: var(--crimson);
  }

  .card-title {
    margin-top: var(--space-8);
    font-family: var(--font-body);
    font-size: var(--size-subhead);
    font-weight: 500;
    line-height: 1.4;
  }

  .summary {
    margin-top: var(--space-8);
    font-size: var(--size-small);
    line-height: 1.5;
    color: var(--muted);
  }

  .more {
    margin-top: var(--space-16);
    font-size: var(--size-small);
    font-weight: 500;
    color: var(--crimson);
  }

  .card-link:hover .more {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* The wide card (first in Selected work) goes side by side at tablet and
     up so its illustration doesn't dominate the page. */
  @media (min-width: 768px) {
    .work-card.wide .card-link {
      display: grid;
      grid-template-columns: 5fr 4fr;
    }

    .work-card.wide .shot {
      aspect-ratio: auto;
      height: 100%;
      border-bottom: none;
      border-right: 1px solid var(--border);
    }
  }
</style>
