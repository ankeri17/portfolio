---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import ArtImage from '../components/ArtImage.astro';

// Home: hero, the two areas of work, three featured case studies, how I
// work, and a closing call to action. Featured entries come from the
// `featured` flag in src/content/work/, sorted by `order`. Only completed
// work is featured here; in-progress entries stay on the Work page.
const featured = (
  await getCollection('work', (entry) => entry.data.featured && entry.data.status === 'complete')
).sort((a, b) => a.data.order - b.data.order);

// Each area carries its own artwork (docs/IMAGE_MANIFEST.md). The images
// are decorative here, the headings carry the meaning, so alt is empty.
const areas = [
  {
    id: 'programs',
    title: 'Programs and operations',
    image: '/images/art/hero-operations.webp',
    imageWidth: 1600,
    imageHeight: 900,
    body: 'I lead cross-functional programs, strengthen operations, and help teams navigate complex change. My experience includes enterprise technology delivery, MarTech and data governance, startup leadership, and organizational transformation.',
    link: 'See the programs and operations work',
  },
  {
    id: 'websites',
    title: 'Websites and marketing',
    image: '/images/art/small-business-websites.webp',
    imageWidth: 1448,
    imageHeight: 1086,
    body: 'I design and build websites and help small businesses create a stronger digital presence. I bring experience in marketing, operations, and business ownership to projects that need practical solutions and ongoing support.',
    link: 'See the websites and marketing work',
  },
];

const principles = [
  {
    title: 'See the whole system',
    body: 'Understand the relationships, dependencies, and constraints affecting the work before deciding what to change.',
  },
  {
    title: 'Clarify ownership and decisions',
    body: 'Establish priorities, responsibilities, and clear paths for making decisions, so work does not stall waiting for someone to call it.',
  },
  {
    title: 'Build processes that last',
    body: 'Create practical operating structures that support delivery without unnecessary overhead, and that a team will keep using.',
  },
  {
    title: 'Connect people and perspectives',
    body: 'Bring business, technical, customer, and leadership perspectives into productive alignment.',
  },
];
---

<Base
  title="Erin Ankeny | Program & Operations Leadership"
  description="Erin Ankeny is a technology program and operations leader with 20+ years of experience across enterprise technology, startups, organizational change, and digital operations."
>
  <section class="hero hero-reveal">
    <div class="hero-text">
      <h1>Making complex work easier to move forward.</h1>
      <div class="hero-rule"></div>
      <p class="lede">
        I lead complex programs, build operations, and bring technical and
        business teams together to turn priorities into progress.
      </p>
      <p class="lede-small">
        My experience spans more than 20 years across enterprise technology,
        startups, organizational change, and digital operations.
      </p>
      <p class="actions">
        <a class="button-primary" href="/work/">Explore my work</a>
        <a class="button-secondary" href="/contact/">Get in touch</a>
      </p>
    </div>
    <div class="hero-art">
      <ArtImage
        src="/images/art/hero-home.webp"
        alt=""
        width={1600}
        height={900}
        loading="eager"
        sizes="(min-width: 1024px) 520px, (min-width: 768px) 50vw, 100vw"
      />
    </div>
  </section>

  <section class="areas" aria-labelledby="what-i-do">
    <div class="content">
      <h2 id="what-i-do">What I do</h2>
      <p class="areas-intro">
        My work spans enterprise leadership and hands-on digital projects.
        Both draw on the same strengths: understanding how the pieces fit
        together, creating clarity, and making things work better.
      </p>
      <div class="area-list">
        {areas.map((area) => (
          <div class="area">
            <div class="area-art">
              <ArtImage
                src={area.image}
                alt=""
                width={area.imageWidth}
                height={area.imageHeight}
                fit="cover"
                sizes="(min-width: 768px) 320px, 100vw"
              />
            </div>
            <h3>{area.title}</h3>
            <p>{area.body}</p>
            <p><a href={`/work/#${area.id}`}>{area.link}</a></p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="featured content" aria-labelledby="selected-work">
    <h2 id="selected-work">Selected work</h2>
    <div class="cards">
      {featured.map((entry, index) => (
        <WorkCard
          id={entry.id}
          title={entry.data.title}
          kind={entry.data.kind}
          summary={entry.data.summary}
          years={entry.data.years}
          status={entry.data.status}
          caseStudy={entry.data.caseStudy}
          category={entry.data.category}
          image={entry.data.image}
          imageAlt={entry.data.imageAlt}
          imageWidth={entry.data.imageWidth}
          imageHeight={entry.data.imageHeight}
          wide={index === 0}
        />
      ))}
    </div>
    <p><a href="/work/">See all the work</a></p>
  </section>

  <section class="how content" aria-labelledby="how-i-work">
    <h2 id="how-i-work">How I work</h2>
    <dl class="principles">
      {principles.map((item) => (
        <div class="principle">
          <dt>{item.title}</dt>
          <dd>{item.body}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="closing">
    <div class="closing-art">
      <ArtImage
        src="/images/art/services.webp"
        alt=""
        width={1448}
        height={1086}
        sizes="(min-width: 1024px) 400px, (min-width: 768px) 40vw, 100vw"
      />
    </div>
    <div class="closing-text">
      <p>
        Whether you're navigating a complex initiative, strengthening
        operations, or building something new, I'd be glad to connect.
      </p>
      <p><a class="button-primary" href="/contact/">Start a conversation</a></p>
    </div>
  </section>
</Base>

<style>
  /* Hero uses the full canvas width so text and artwork sit side by side
     at desktop. Text first in source so it reads first on mobile. */
  .hero {
    padding-block-start: var(--space-48);
    display: grid;
    gap: var(--space-32);
    align-items: center;
  }

  .hero-art img {
    border-radius: var(--radius-card);
  }

  .hero h1 {
    font-size: var(--size-hero);
    line-height: 1.12;
    letter-spacing: -0.01em;
  }

  .hero-rule {
    width: 52px;
    height: 3px;
    background: var(--gold);
    margin-top: var(--space-24);
  }

  .hero .lede {
    margin-top: var(--space-24);
    font-size: var(--size-subhead);
    line-height: 1.5;
    max-width: 48ch;
  }

  .hero .lede-small {
    margin-top: var(--space-12);
    color: var(--muted);
  }

  .hero .actions {
    margin-top: var(--space-32);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-12) var(--space-16);
    align-items: center;
  }

  /* Full-bleed tinted band. The negative margins stretch the section to
     the viewport edges; the inner .content column stays aligned. */
  .areas {
    margin-top: var(--section-gap);
    margin-inline: calc(50% - 50vw);
    background: var(--panel);
    padding-block: var(--space-48);
    padding-inline: var(--gutter);
  }

  .areas-intro {
    margin-top: var(--space-12);
    color: var(--muted);
  }

  .area-list {
    margin-top: var(--space-32);
    display: grid;
    gap: var(--space-24);
  }

  .area {
    padding-top: var(--space-24);
    border-top: 1px solid var(--border);
  }

  /* Both area images crop to the same wide frame so the two columns line
     up; the compositions are centered so the crop is safe. */
  .area-art {
    aspect-ratio: 3 / 2;
    border-radius: var(--radius-card);
    overflow: hidden;
    margin-bottom: var(--space-16);
  }

  .area p {
    margin-top: var(--space-8);
  }

  .area p + p {
    margin-top: var(--space-12);
    font-size: var(--size-small);
    font-weight: 500;
  }

  .featured,
  .how,
  .closing {
    margin-top: var(--section-gap);
  }

  .featured .cards {
    display: grid;
    gap: var(--space-16);
    margin-top: var(--space-24);
  }

  .featured .cards + p {
    margin-top: var(--space-24);
  }

  .principles {
    margin-top: var(--space-24);
    display: grid;
    gap: var(--space-24);
  }

  .principle {
    padding-top: var(--space-16);
    border-top: 1px solid var(--border);
  }

  .principle dt {
    font-size: var(--size-subhead);
    font-weight: 500;
    line-height: 1.4;
  }

  .principle dd {
    margin-top: var(--space-8);
    color: var(--muted);
    max-width: 60ch;
  }

  .closing {
    display: grid;
    gap: var(--space-32);
    align-items: center;
  }

  .closing-art img {
    border-radius: var(--radius-card);
  }

  .closing-text p:first-child {
    font-family: var(--font-display);
    font-size: var(--size-heading);
    line-height: 1.25;
    text-wrap: balance;
  }

  .closing-text p + p {
    margin-top: var(--space-32);
  }

  @media (min-width: 768px) {
    .hero {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-48);
      padding-block-start: var(--space-64);
    }

    .closing {
      grid-template-columns: 2fr 3fr;
      gap: var(--space-48);
    }

    .area-list {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-32);
    }

    .featured .cards {
      grid-template-columns: 1fr 1fr;
    }

    .featured .cards > :global(.work-card.wide) {
      grid-column: 1 / -1;
    }

    .principles {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-32);
    }
  }

  @media (min-width: 1024px) {
    .hero {
      grid-template-columns: minmax(0, 7fr) minmax(0, 6fr);
      gap: var(--space-64);
      padding-block-start: var(--space-96);
    }

    .areas {
      padding-block: var(--space-64);
    }
  }
</style>
