---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Marginalia from '../components/Marginalia.astro';
import WorkCard from '../components/WorkCard.astro';


const featured = (await getCollection('work', (entry) => entry.data.featured))
  .sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Erin Ankeny"
  description="Program and operations leadership, MarTech and data governance, and web and brand work for small businesses."
>
  <section class="hero content hero-reveal">
    <h1>I help people who don't speak the same language build things together.</h1>
    <p>
      Twenty years helping technical teams and everyone else to understand each
      other... including our new AI partners.
    </p>
  </section>

  <section class="doors content">
    <p class="eyebrow">How to work with me</p>
    <div class="annotated">

      <p>
        I lead programs and operations for teams in the middle of change,
        including agile and transformation work. I untangle MarTech, data, and
        privacy and consent governance. And I build websites and brands for
        small businesses, with property and home services as the corner of the world I know
        best.
      </p>
    </div>
    <p>
      Different rooms, same job: getting people with different vocabularies
      working from the same page, so work ships more smoothly.
    </p>
  </section>

  <section class="featured content">
    <h2>Selected work</h2>
    <div class="cards">
      {featured.map((entry) => (
        <WorkCard
          id={entry.id}
          title={entry.data.title}
          kind={entry.data.kind}
          summary={entry.data.summary}
        />
      ))}
    </div>
    <p><a href="/work/">See more of the work</a></p>
  </section>

  <section class="closing content">
    <p>
      If you're hiring for program or operations work, wrestling with your
      MarTech stack, or a small business that needs a site built by someone
      who's run the whole function, let's talk.
    </p>
    <p><a class="button-primary" href="/contact/">Start a conversation</a></p>
  </section>
</Base>

<style>
  .hero {
    padding-block-start: var(--section-gap);
  }

  .hero h1 {
    font-size: var(--size-hero);
    line-height: 1.12;
    letter-spacing: -0.01em;
  }

  .hero p {
    margin-top: var(--space-24);
    font-size: var(--size-subhead);
    color: var(--muted);
  }

  .doors,
  .featured,
  .closing {
    margin-top: var(--section-gap);
  }

  .doors .eyebrow {
    margin-bottom: var(--space-16);
  }

  .doors .annotated + p {
    margin-top: var(--space-16);
  }

  .featured .cards {
    display: grid;
    gap: var(--space-16);
    margin-top: var(--space-24);
  }

  .featured .cards + p {
    margin-top: var(--space-24);
  }

  .closing p:first-child {
    font-family: var(--font-display);
    font-size: var(--size-heading);
    line-height: 1.25;
    text-wrap: balance;
  }

  .closing p + p {
    margin-top: var(--space-32);
  }

  @media (min-width: 768px) {
    .featured .cards {
      grid-template-columns: 1fr 1fr;
    }

    .featured .cards > :global(.work-card:first-child) {
      grid-column: 1 / -1;
    }
  }
</style>
