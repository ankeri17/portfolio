---
import Base from '../layouts/Base.astro';
import ArtImage from '../components/ArtImage.astro';

// One clear ask, one simple form, and what she's open to. The form posts
// to Netlify Forms (the data-netlify attribute wires it up at deploy time)
// with a honeypot for spam and a mailto fallback below. Native browser
// validation does the work without JavaScript; the small script at the
// bottom only improves the messages and reports submit errors.
//
// The field list must stay in sync with public/__forms.html, which
// Netlify's build-time scanner reads.

const topics = [
  { value: 'programs', label: 'Programs and operations' },
  { value: 'websites', label: 'Websites and marketing' },
  { value: 'general', label: 'General inquiry' },
];
---

<Base
  title="Contact Erin Ankeny"
  description="Connect with Erin Ankeny about technology program leadership, operations, consulting, and website or marketing projects."
>
  <div class="content">
    <header class="page-intro">
      <h1>Say hello</h1>
      <p>
        Whether you're looking for an experienced program and operations
        leader, need support with a complex initiative, or have a website
        project in mind, I'd be glad to hear about it.
      </p>
    </header>

    <section class="open-to" aria-labelledby="open-to-heading">
      <h2 id="open-to-heading" class="eyebrow">What I'm open to</h2>
      <ul>
        <li>
          <strong>Leadership opportunities.</strong> Senior roles in technical
          program management, operations, cross-functional leadership, and
          organizational improvement.
        </li>
        <li>
          <strong>Consulting and project work.</strong> Program delivery,
          MarTech operations, process improvement, and initiatives requiring
          coordination across teams.
        </li>
        <li>
          <strong>Websites and marketing.</strong> Website design,
          development, maintenance, and practical digital marketing support
          for small businesses.
        </li>
      </ul>
      <p>
        Have something else in mind? I'm always happy to connect with people
        doing interesting work.
      </p>
    </section>

  </div>

  <div class="form-row">
    <form
      name="contact"
      method="POST"
      action="/thanks/"
      data-netlify="true"
      data-netlify-honeypot="bot-field"
    >
      <input type="hidden" name="form-name" value="contact" />
      <p class="honeypot" aria-hidden="true">
        <label>Leave this field empty: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
      </p>
      <div class="field">
        <label for="name">Name</label>
        <input id="name" name="name" type="text" autocomplete="name" required aria-describedby="name-error" />
        <p class="error" id="name-error" hidden>Please add your name.</p>
      </div>
      <div class="field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" required aria-describedby="email-hint email-error" />
        <p class="hint" id="email-hint">So I can reply. I won't share it.</p>
        <p class="error" id="email-error" hidden>Please enter an email address I can reply to.</p>
      </div>
      <div class="field">
        <label for="topic">What's this about?</label>
        <select id="topic" name="topic" aria-describedby="topic-hint">
          <option value="">Choose one, if you like</option>
          {topics.map((topic) => (
            <option value={topic.value}>{topic.label}</option>
          ))}
        </select>
        <p class="hint" id="topic-hint">Optional.</p>
      </div>
      <div class="field">
        <label for="message">What you're working on</label>
        <textarea id="message" name="message" required aria-describedby="message-error"></textarea>
        <p class="error" id="message-error" hidden>Tell me a little about it, even one line is fine.</p>
      </div>
      <p class="form-status" role="status" aria-live="polite" hidden></p>
      <button class="button-primary" type="submit">Send message</button>
    </form>
    <div class="form-art">
      <ArtImage
        src="/images/art/contact.webp"
        alt=""
        width={1448}
        height={1086}
        sizes="(min-width: 1024px) 380px, (min-width: 768px) 40vw, 100vw"
      />
    </div>
  </div>

  <div class="content">
    <p class="fallback">
      Prefer email? Write to{' '}
      <a href="mailto:erinankeny@gmail.com">erinankeny@gmail.com</a>. You can
      also find me on <a href="https://www.linkedin.com/in/erinankeny">LinkedIn</a>.
    </p>
  </div>
</Base>

<script>
  // Progressive enhancement. Without this script the browser's native
  // validation and the normal POST to Netlify still work. With it: inline
  // messages per field, focus on the first problem, and a visible error if
  // the submission itself fails instead of a blank Netlify error page.
  const form = document.querySelector<HTMLFormElement>('form[name="contact"]');

  if (form) {
    const status = form.querySelector<HTMLElement>('.form-status');
    const fields = Array.from(
      form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]')
    );

    function errorFor(field: HTMLElement) {
      return document.getElementById(`${field.id}-error`);
    }

    function showError(field: HTMLInputElement | HTMLTextAreaElement, show: boolean) {
      const error = errorFor(field);
      if (!error) return;
      error.hidden = !show;
      field.setAttribute('aria-invalid', show ? 'true' : 'false');
    }

    function validate() {
      let first: HTMLElement | null = null;
      for (const field of fields) {
        const ok = field.checkValidity();
        showError(field, !ok);
        if (!ok && !first) first = field;
      }
      return first;
    }

    for (const field of fields) {
      field.addEventListener('blur', () => showError(field, !field.checkValidity()));
      field.addEventListener('input', () => {
        if (field.checkValidity()) showError(field, false);
      });
    }

    form.noValidate = true;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const first = validate();
      if (first) {
        first.focus();
        return;
      }

      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (button) button.disabled = true;
      if (status) {
        status.hidden = false;
        status.textContent = 'Sending your message.';
      }

      try {
        const body = new URLSearchParams(new FormData(form) as unknown as Record<string, string>);
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body,
        });
        if (!response.ok) throw new Error(`Form submission failed: ${response.status}`);
        window.location.assign(form.action);
      } catch {
        if (button) button.disabled = false;
        if (status) {
          status.textContent =
            'Something went wrong sending that. Please try again, or email erinankeny@gmail.com directly.';
        }
      }
    });
  }
</script>

<style>
  .page-intro {
    padding-block-start: var(--space-48);
  }

  .page-intro p {
    margin-top: var(--space-16);
    font-size: var(--size-subhead);
    color: var(--muted);
  }

  .open-to {
    margin-top: var(--space-48);
  }

  .open-to h2 {
    font-size: var(--size-eyebrow);
    margin-bottom: var(--space-12);
  }

  .open-to ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-12);
    max-width: 68ch;
  }

  .open-to li {
    padding-top: var(--space-12);
    border-top: 1px solid var(--border);
  }

  .open-to strong {
    font-weight: 500;
  }

  .open-to p {
    margin-top: var(--space-16);
    color: var(--muted);
  }

  /* Form first in source, so on a phone it comes before the artwork and
     stays easy to reach. Side by side from tablet up. */
  .form-row {
    margin-top: var(--space-48);
    display: grid;
    gap: var(--space-32);
    align-items: start;
  }

  form {
    width: 100%;
    max-width: 520px;
  }

  .form-art img {
    border-radius: var(--radius-card);
  }

  form .button-primary {
    margin-top: var(--space-24);
  }

  .form-status {
    margin-top: var(--space-16);
    font-size: var(--size-small);
    color: var(--crimson);
  }

  .fallback {
    margin-top: var(--space-32);
    font-size: var(--size-small);
    color: var(--muted);
  }

  @media (min-width: 768px) {
    .form-row {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-48);
    }

    .form-art {
      margin-top: var(--space-24);
    }
  }

  @media (min-width: 1024px) {
    .page-intro {
      padding-block-start: var(--space-64);
    }
  }
</style>
