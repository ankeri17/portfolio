---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import ArtImage from '../components/ArtImage.astro';

// The portfolio page. Entries live as markdown files in src/content/work/
// and are grouped into the same two areas the Home page introduces.
// Within each area, completed work sorts above in-progress work, then by
// `order`. Each card carries the entry's id as an anchor so older
// /work/#id links still land on the right entry.

const entries = await getCollection('work');

function sortEntries(list: typeof entries) {
  return list.sort((a, b) => {
    if (a.data.status !== b.data.status) {
      return a.data.status === 'complete' ? -1 : 1;
    }
    return a.data.order - b.data.order;
  });
}

const sections = [
  {
    id: 'programs',
    title: 'Programs and operations',
    intro:
      'Enterprise delivery, cross-functional leadership, MarTech governance, and operations work inside startups and large companies.',
    entries: sortEntries(entries.filter((e) => e.data.category === 'programs')),
  },
  {
    id: 'websites',
    title: 'Websites and marketing',
    intro:
      'Websites, brands, and the marketing function itself for small businesses, plus independent projects I build and run end to end.',
    entries: sortEntries(entries.filter((e) => e.data.category === 'websites')),
  },
];
---

<Base
  title="Work | Erin Ankeny"
  description="Selected work from twenty years across enterprise program management, startup operations, and websites and marketing for small businesses."
>
  <header class="page-intro">
    <div class="intro-text">
      <h1>Work</h1>
      <p>
        A selection of what I've led, built, and run, in two areas. Each one is
        the same job in a different room: getting people with different
        vocabularies working from the same page.
      </p>
    </div>
    <div class="intro-art">
      <ArtImage
        src="/images/art/hero-work.webp"
        alt=""
        width={1600}
        height={900}
        loading="eager"
        sizes="(min-width: 1024px) 480px, (min-width: 768px) 50vw, 100vw"
      />
    </div>
  </header>

  <div class="content">

    {sections.map((section) => (
      <section class="area" id={section.id} aria-labelledby={`${section.id}-heading`}>
        <h2 id={`${section.id}-heading`}>{section.title}</h2>
        <p class="area-intro">{section.intro}</p>
        <div class="cards">
          {section.entries.map((entry) => (
            <WorkCard
              id={entry.id}
              title={entry.data.title}
              kind={entry.data.kind}
              summary={entry.data.summary}
              years={entry.data.years}
              status={entry.data.status}
              caseStudy={entry.data.caseStudy}
              category={entry.data.category}
              image={entry.data.image}
              imageAlt={entry.data.imageAlt}
          imageWidth={entry.data.imageWidth}
          imageHeight={entry.data.imageHeight}
            />
          ))}
        </div>
      </section>
    ))}

    <p class="also">
      I also build and maintain smaller sites, including{' '}
      <a href="https://blbrenovations.com">blbrenovations.com</a>.
    </p>
  </div>
</Base>

<style>
  /* Intro spans the full canvas so the artwork can sit beside the text. */
  .page-intro {
    padding-block-start: var(--space-48);
    display: grid;
    gap: var(--space-32);
    align-items: center;
  }

  .page-intro p {
    margin-top: var(--space-16);
    font-size: var(--size-subhead);
    color: var(--muted);
  }

  .intro-art img {
    border-radius: var(--radius-card);
  }

  .area {
    margin-top: var(--section-gap);
    padding-top: var(--space-48);
    border-top: 1px solid var(--border);
  }

  .area-intro {
    margin-top: var(--space-12);
    color: var(--muted);
  }

  .cards {
    display: grid;
    gap: var(--space-16);
    margin-top: var(--space-32);
  }

  .also {
    margin-top: var(--section-gap);
    padding-top: var(--space-32);
    border-top: 1px solid var(--border);
    font-size: var(--size-small);
    color: var(--muted);
  }

  @media (min-width: 768px) {
    .page-intro {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-48);
    }

    .cards {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    .page-intro {
      padding-block-start: var(--space-64);
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      gap: var(--space-64);
    }

    .area {
      padding-top: var(--space-64);
    }
  }
</style>
