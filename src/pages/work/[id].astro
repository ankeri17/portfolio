---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArtImage from '../../components/ArtImage.astro';

// Case study page, one per work entry with `caseStudy: true`. The entry's
// markdown body carries the five sections (Overview, Challenge, My role,
// Approach, Outcome) as h2 headings; this template adds the header, the
// facts block, the illustration, and the highlight.

export async function getStaticPaths() {
  const entries = await getCollection('work', (entry) => entry.data.caseStudy);
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const areaLabel = d.category === 'programs' ? 'Programs and operations' : 'Websites and marketing';

const facts = [
  { label: 'Organization', value: d.organization },
  { label: 'Role', value: d.role },
  { label: 'Years', value: d.years },
  { label: 'Status', value: d.status === 'in-progress' ? 'In progress' : undefined },
].filter((f) => f.value);

---

<Base
  title={`${d.title} | Erin Ankeny`}
  description={`${d.organization ? `${d.organization}: ` : ''}${d.summary}`}
>
  <article class="content case-study">
    <header class="page-intro">
      <p class="eyebrow">
        <a href={`/work/#${d.category}`}>{areaLabel}</a> · {d.kind}
      </p>
      <h1>{d.title}</h1>
      <p class="summary">{d.summary}</p>
    </header>

    {facts.length > 0 && (
      <dl class="facts">
        {facts.map((fact) => (
          <div class="fact">
            <dt>{fact.label}</dt>
            <dd>
              {fact.value}
            </dd>
          </div>
        ))}
        {d.link && (
          <div class="fact">
            <dt>Site</dt>
            <dd><a href={d.link}>{d.link.replace(/^https?:\/\//, '')}</a></dd>
          </div>
        )}
      </dl>
    )}

    <figure class="shot">
      {d.image ? (
        <ArtImage
          src={d.image}
          alt={d.imageAlt ?? ''}
          width={d.imageWidth}
          height={d.imageHeight}
          loading="eager"
        />
      ) : null}
    </figure>

    {d.highlight && <p class="highlight">{d.highlight}</p>}

    <div class="body">
      <Content />
    </div>

    <footer class="case-footer">
      <p><a href={`/work/#${d.category}`}>Back to {areaLabel.toLowerCase()}</a></p>
      <p>
        Working on something like this?{' '}
        <a href="/contact/">Get in touch</a>.
      </p>
    </footer>
  </article>
</Base>

<style>
  .page-intro {
    padding-block-start: var(--space-48);
  }

  .page-intro .eyebrow {
    margin-bottom: var(--space-8);
  }

  .page-intro .eyebrow a {
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-color: color-mix(in srgb, var(--crimson) 40%, transparent);
  }

  .page-intro .eyebrow a:hover {
    color: var(--crimson);
    text-decoration-color: var(--crimson);
  }

  .summary {
    margin-top: var(--space-16);
    font-size: var(--size-subhead);
    color: var(--muted);
  }

  .facts {
    margin-top: var(--space-32);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: var(--space-16) var(--space-24);
    padding-block: var(--space-16);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    font-size: var(--size-small);
    line-height: 1.5;
  }

  .fact dt {
    color: var(--muted);
  }

  .fact dd {
    margin-top: var(--space-4);
    font-weight: 500;
  }

  /* The artwork sets its own height so the whole composition shows. */
  .shot {
    margin-top: var(--space-32);
    background: var(--panel);
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  .shot:not(:has(img)) {
    display: none;
  }

  .highlight {
    margin-top: var(--space-32);
    border-left: 2px solid var(--crimson);
    padding-left: var(--space-16);
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--size-subhead);
    line-height: 1.5;
    max-width: 52ch;
  }

  .body :global(h2) {
    margin-top: var(--space-48);
  }

  .body :global(p) {
    margin-top: var(--space-16);
  }

  .case-footer {
    margin-top: var(--section-gap);
    padding-top: var(--space-32);
    border-top: 1px solid var(--border);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-12) var(--space-32);
    font-size: var(--size-small);
    color: var(--muted);
  }

  @media (min-width: 1024px) {
    .page-intro {
      padding-block-start: var(--space-64);
    }

    .body :global(h2) {
      margin-top: var(--space-64);
    }
  }
</style>
