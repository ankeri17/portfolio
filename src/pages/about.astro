---
import Base from '../layouts/Base.astro';
import Marginalia from '../components/Marginalia.astro';

// About: a short professional introduction, how she approaches the work,
// a scannable career timeline, and a condensed note on technology and AI.
// Facts come from Erin's LinkedIn export and her own notes. Anything not
// verified carries a visible placeholder (BRAND.md section 12).

const approach = [
  {
    title: 'Cross-functional collaboration',
    body: 'I spend most of my time at the seams between teams, because that is where work gets lost.',
  },
  {
    title: 'Systems thinking',
    body: 'A late deliverable is usually a symptom. I look for the structure underneath before fixing the surface.',
  },
  {
    title: 'Transparent communication',
    body: 'People can handle bad news. What they cannot handle is finding out late. I say what I know, early.',
  },
  {
    title: 'Practical operational structure',
    body: 'Enough process to make the work predictable, and no more. A plan nobody follows is not a plan.',
  },
  {
    title: 'Thoughtful decision-making',
    body: 'Name the decision, name who makes it, and write down why. Most arguments are really about an unnamed decision.',
  },
  {
    title: 'Adaptability in complex environments',
    body: 'Mergers, startups, transformations. I have done my best work in places where the ground was moving.',
  },
];

// Career highlights, most recent first. Years from Erin; the Gloto dates
// are still outstanding.
const timeline = [
  {
    years: '2026',
    title: 'Technical program manager',
    org: 'Red Hat',
    note: 'Current role.',
  },
  {
    years: '2021 to 2026',
    title: 'First employee, product operations and customer support',
    org: 'Sentinel Insights',
    note: 'Founding team of a MarTech monitoring startup.',
    link: '/work/sentinel-insights/',
  },
  {
    years: '2021 to 2025',
    title: 'Program management, agile and digital transformation, web and MarTech',
    org: 'Project 3 Consulting, later Northern',
    note: 'Boutique agency work in parallel with Sentinel Insights.',
  },
  {
    years: '2023 to 2024',
    title: 'Agile coach, marketing operations',
    org: 'Humana',
    note: 'Coached marketing operations teams through an agile transformation.',
  },
  {
    years: '2018 to 2021',
    title: 'Scrum Master and project manager, then senior IT program manager',
    org: 'TD Ameritrade, then Charles Schwab',
    note: 'MarTech Enablement and Data Architecture Lab, through the merger.',
    link: '/work/td-ameritrade-schwab/',
  },
  {
    years: '2017 to 2024',
    title: 'Marketing lead',
    org: 'Inside Out Home Inspector',
    note: 'The full marketing function for a family-owned business, now closed.',
    link: '/work/inside-out-home-inspector/',
  },
  {
    years: '2017 to 2018',
    title: 'Technical writer',
    org: 'Oracle',
  },
  {
    years: '[PLACEHOLDER: Gloto years, needs Erin]',
    title: 'Client services, then EVP of operations',
    org: 'Gloto',
    note: 'Five years at a mobile and web build startup serving national brands.',
    link: '/work/gloto/',
  },
  {
    years: '2007 to 2011',
    title: 'Technical writer',
    org: 'Raytheon Solipsys',
    note: 'Manuals, training, and usability testing.',
  },
  {
    years: 'Since 2007',
    title: 'Founder and operator',
    org: 'ShopHappens.com',
    note: 'An affiliate content site, built and run end to end.',
    link: '/work/shophappens/',
  },
];

function isPlaceholder(value?: string) {
  return value?.startsWith('[PLACEHOLDER');
}
---

<Base
  title="About | Erin Ankeny"
  description="Erin Ankeny has spent over 20 years connecting technical and business teams, from technical writing to enterprise program management to founding-team operations."
>
  <div class="content">
    <header class="page-intro">
      <h1>About</h1>
      <figure class="headshot">
        <img
          src="/images/headshot.webp"
          alt="Erin Ankeny, smiling in front of a brick wall"
          width="400"
          height="400"
          loading="eager"
          decoding="async"
        />
      </figure>
      <p>
        I've spent over 20 years being the person who gets groups with
        different vocabularies working from the same page, in enterprise
        technology, startups, and small businesses.
      </p>
    </header>

    <section aria-labelledby="intro-heading">
      <h2 id="intro-heading">What I do</h2>
      <p>
        I lead programs and operations for teams in the middle of change. That
        has meant running delivery for MarTech engineering teams through a
        merger, building the operations of a startup from its first employee,
        coaching marketing teams through an agile transformation, and running
        client services for a build shop serving national brands.
      </p>
      <p>
        The problems I'm good at tend to look the same underneath: a lot of
        capable people, several vocabularies, and no shared picture of the
        work. I make the picture, get everyone looking at it, and keep it
        current until the work ships.
      </p>
      <p>
        I also build websites and brands for small businesses, with property
        and home services as the corner of the world I know best. I've worked
        inside those businesses, not just built websites for them. I ran the
        marketing function for a family-owned home inspection company for
        roughly seven years, and I've been a licensed real estate agent since
        2016, still handling{' '}
        <a href="https://realtyconnect.net/site/erin-ankeny/">relocation referrals</a>{' '}
        through a nationwide network.
      </p>
    </section>

    <section aria-labelledby="approach-heading">
      <h2 id="approach-heading">How I approach the work</h2>
      <dl class="approach">
        {approach.map((item) => (
          <div class="approach-item">
            <dt>{item.title}</dt>
            <dd>{item.body}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section aria-labelledby="highlights-heading">
      <h2 id="highlights-heading">Career highlights</h2>
      <div class="annotated">
        <Marginalia>
          Same job, different titles: technical writer, program manager,
          operations lead.
        </Marginalia>
        <p>
          I started as a technical writer, turning what engineers build into
          something the rest of the world can understand. Everything since has
          depended on that skill.
        </p>
      </div>
      <ol class="timeline">
        {timeline.map((item) => (
          <li class="timeline-item">
            <p class="timeline-years">
              {isPlaceholder(item.years) ? (
                <span class="placeholder">{item.years}</span>
              ) : (
                item.years
              )}
            </p>
            <div class="timeline-body">
              <p class="timeline-title">{item.title}</p>
              <p class="timeline-org">
                {item.link ? <a href={item.link}>{item.org}</a> : item.org}
              </p>
              {item.note && <p class="timeline-note">{item.note}</p>}
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section aria-labelledby="ai-heading">
      <h2 id="ai-heading">Technology and AI</h2>
      <p>
        I use AI the way I've used every new tool in twenty years of technical
        work: to get more done without lowering the standard. In practice that
        means deciding which parts of a project belong to a person and which to
        a model, being precise about what I'm asking for, and checking what
        comes back before it goes anywhere.
      </p>
      <p>
        It shows up in how I plan work, draft documentation, build sites, and
        clear the repetitive parts of operations so the team can spend its
        time on judgment. This site was built that way: I wrote the brief and
        the design rules, a model wrote the first pass, and every line got a
        human read.
      </p>
    </section>
  </div>
</Base>

<style>
  .page-intro {
    padding-block-start: var(--space-48);
  }

  .page-intro p {
    margin-top: var(--space-16);
    font-size: var(--size-subhead);
    color: var(--muted);
    max-width: 60ch;
  }

  .headshot {
    margin-top: var(--space-24);
    width: 200px;
  }

  .headshot img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-card);
  }

  section {
    margin-top: var(--space-48);
  }

  section p + p {
    margin-top: var(--space-16);
  }

  h2 {
    margin-bottom: var(--space-16);
  }

  .approach {
    display: grid;
    gap: var(--space-16);
  }

  .approach-item {
    padding-top: var(--space-16);
    border-top: 1px solid var(--border);
  }

  .approach-item dt {
    font-weight: 500;
  }

  .approach-item dd {
    margin-top: var(--space-4);
    color: var(--muted);
    font-size: var(--size-small);
    line-height: 1.5;
  }

  .timeline {
    list-style: none;
    padding: 0;
    margin-top: var(--space-24);
  }

  .timeline-item {
    display: grid;
    gap: var(--space-4) var(--space-24);
    padding-block: var(--space-16);
    border-top: 1px solid var(--border);
  }

  /* Both selectors are needed to outrank the generic `section p + p`
     spacing rule above once Astro scopes them. */
  .timeline-item p,
  .timeline-item p + p {
    margin: 0;
  }

  .timeline-years {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--size-eyebrow);
    color: var(--muted);
  }

  .timeline-title {
    font-weight: 500;
  }

  .timeline-org {
    font-size: var(--size-small);
  }

  .timeline-item p + p.timeline-note {
    margin-top: var(--space-4);
    font-size: var(--size-small);
    color: var(--muted);
    line-height: 1.5;
  }

  @media (min-width: 768px) {
    .page-intro {
      display: grid;
      grid-template-columns: 1fr 200px;
      gap: var(--space-16) var(--space-48);
      align-items: start;
    }

    .page-intro h1 {
      grid-column: 1;
    }

    .page-intro p {
      grid-column: 1;
    }

    .headshot {
      grid-column: 2;
      grid-row: 1 / 3;
      margin-top: 0;
    }

    .approach {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-16) var(--space-32);
    }

    .timeline-item {
      grid-template-columns: 140px 1fr;
    }
  }

  @media (min-width: 1024px) {
    .page-intro {
      padding-block-start: var(--space-64);
    }

    section {
      margin-top: var(--space-64);
    }
  }
</style>
