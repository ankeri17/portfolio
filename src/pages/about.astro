---
import Base from '../layouts/Base.astro';
import Marginalia from '../components/Marginalia.astro';
import ArtImage from '../components/ArtImage.astro';

// About: a short professional introduction, how she approaches the work,
// a scannable career timeline, education, and a note on technology and AI.
// Facts come from Erin's verified background brief (October 2026). Nothing
// unverified appears (BRAND.md section 12).

const approach = [
  {
    title: 'Systems thinking',
    body: 'Most problems that look like a late deliverable are really about how the pieces fit together. I look for the structure underneath before I touch the surface.',
  },
  {
    title: 'Collaborative leadership',
    body: 'I lead by making the work visible and the decisions explicit, so people across engineering, marketing, customers, and leadership can contribute from where they sit.',
  },
  {
    title: 'Transparency and good judgment',
    body: 'I say what I know, early, including the bad news. When the right call is not obvious, I weigh the tradeoffs openly and own the decision.',
  },
  {
    title: 'Practical execution',
    body: 'Plans and process only matter if the work ships. I stay close enough to the day-to-day to know what is actually happening, and I do the work myself when that is what the moment needs.',
  },
];

// Career timeline, most prominent first. Dates and titles are from Erin's
// verified background (October 2026). Overlapping roles are shown as they
// were; consulting ran alongside Sentinel Insights for most of those years.
const timeline = [
  {
    years: 'July 2026 to present',
    title: 'Technical program manager',
    org: 'Red Hat',
    note: 'Current role.',
  },
  {
    years: 'July 2021 to June 2026',
    title: 'Founding team member and executive vice president',
    org: 'Sentinel Insights',
    note: 'First employee of a B2B SaaS company focused on MarTech data quality, consent validation, and real-user monitoring. Strategic advisor to three CEOs.',
    link: '/work/sentinel-insights/',
  },
  {
    years: 'August 2021 to March 2025',
    title: 'Principal consultant',
    org: 'Project 3 Consulting',
    note: 'Program and project management, agile and digital transformation, marketing technology, web development, and process improvement. Engagements included enterprise agile coaching for a digital marketing technology program at Bayer Crop Science.',
  },
  {
    years: 'January 2024 to April 2025',
    title: 'Agile coach, marketing operations transformation',
    org: 'Humana',
    note: 'Supported the launch of four new agile pods and coached ten more, along with product owners, Scrum Masters, and leaders. Built communities of practice, playbooks, and working agreements, and delivered training that reached more than 150 people.',
  },
  {
    years: 'June 2021 to August 2021',
    title: 'Senior IT program manager',
    org: 'Charles Schwab',
    note: 'Tag management and data architecture across the combined TD Ameritrade and Schwab digital properties.',
    link: '/work/td-ameritrade-schwab/',
  },
  {
    years: 'July 2018 to June 2021',
    title: 'Senior enterprise and technical project manager',
    org: 'TD Ameritrade',
    note: 'MarTech Enablement and Data Architecture Lab. Coordinated two engineering delivery teams through the Schwab merger.',
    link: '/work/td-ameritrade-schwab/',
  },
  {
    years: 'January 2017 to September 2024',
    title: 'Marketing consultant',
    org: 'Inside Out Home Inspector',
    note: 'Branding, social media, and marketing strategy for a family-owned home inspection business.',
    link: '/work/inside-out-home-inspector/',
  },
  {
    years: 'July 2017 to July 2018',
    title: 'Senior technical writer',
    org: 'Oracle',
    note: 'Global product documentation for Oracle Hospitality, working with cross-functional scrum teams. Led the Maryland Oracle Women\'s Leadership group.',
  },
  {
    years: 'January 2012 to June 2016',
    title: 'Director of client services, then executive vice president',
    org: 'Gloto',
    note: 'Director of client services and project manager from January 2012, then executive vice president and operations manager from May 2014. Custom web and mobile products for national brands.',
    link: '/work/gloto/',
  },
  {
    years: '2006 to 2011',
    title: 'Technical writing, training, and publications',
    org: 'Raytheon Solipsys, then Xerox/ACS',
    note: 'Senior technical writer, editor, and trainer at Raytheon Solipsys from July 2006 to March 2011, then publications specialist at Xerox/ACS. Before that, customer support and operations roles at Verizon Business and Capital One.',
  },
  {
    years: 'Since 2007',
    title: 'Founder and operator',
    org: 'ShopHappens.com',
    note: 'An affiliate content site, built and run end to end.',
    link: '/work/shophappens/',
  },
];

---

<Base
  title="About Erin Ankeny | Experience & Approach"
  description="Learn about Erin Ankeny's experience in enterprise program management, startup executive leadership, agile transformation, and digital business."
>
  <div class="content">
    <header class="page-intro">
      <h1>About</h1>
      <figure class="headshot">
        <img
          src="/images/headshot.webp"
          alt="Erin Ankeny, smiling in front of a brick wall"
          width="400"
          height="400"
          loading="eager"
          decoding="async"
        />
      </figure>
      <p>
        I've spent more than 20 years working at the intersection of
        technology, business, and people. My career has taken me from
        technical writing to enterprise program management and executive
        startup leadership, with a consistent focus on making complex work
        understandable and manageable.
      </p>
    </header>

    <section aria-labelledby="intro-heading">
      <h2 id="intro-heading">What I do</h2>
      <p>
        I lead programs and operations in environments where priorities
        compete, teams depend on one another, and the path forward isn't
        always obvious.
      </p>
      <p>
        I've coordinated enterprise MarTech initiatives through a major
        corporate merger, helped build a SaaS startup as its first employee,
        supported organizational transformation through agile coaching, and
        led client services and operations for a technology startup working
        with national brands.
      </p>
      <p>
        Those experiences have shaped how I work. I connect the broader
        business context to the practical decisions teams make every day. I
        help people understand what matters, establish ownership, and build
        the structure needed to deliver.
      </p>
      <p>
        I also design websites and support marketing for small businesses.
        Having managed marketing for a family-owned home inspection company
        and worked in real estate since 2016, including{' '}
        <a href="https://realtyconnect.net/site/erin-ankeny/">relocation referrals</a>{' '}
        today, I understand many of the practical challenges small business
        owners face.
      </p>
    </section>

    <section aria-labelledby="approach-heading" class="approach-section">
      <div class="approach-text">
        <h2 id="approach-heading">How I approach the work</h2>
        <dl class="approach">
          {approach.map((item) => (
            <div class="approach-item">
              <dt>{item.title}</dt>
              <dd>{item.body}</dd>
            </div>
          ))}
        </dl>
      </div>
      <div class="approach-art">
        <ArtImage
          src="/images/art/about.webp"
          alt=""
          width={1122}
          height={1402}
          sizes="(min-width: 1024px) 300px, (min-width: 768px) 260px, 100vw"
        />
      </div>
    </section>

    <section aria-labelledby="highlights-heading">
      <h2 id="highlights-heading">Career highlights</h2>
      <div class="annotated">
        <Marginalia>
          Same job, different titles: technical writer, program manager,
          operations lead.
        </Marginalia>
        <p>
          I started as a technical writer, turning what engineers build into
          something the rest of the world can understand. Everything since,
          from program leadership to running a startup's operations, has
          depended on that skill.
        </p>
      </div>
      <ol class="timeline">
        {timeline.map((item) => (
          <li class="timeline-item">
            <p class="timeline-years">{item.years}</p>
            <div class="timeline-body">
              <p class="timeline-title">{item.title}</p>
              <p class="timeline-org">
                {item.link ? <a href={item.link}>{item.org}</a> : item.org}
              </p>
              {item.note && <p class="timeline-note">{item.note}</p>}
            </div>
          </li>
        ))}
      </ol>
      <p class="parallel">
        Alongside those roles I've worked as a consultant for an insurance
        agency, Knights of Columbus Insurance through the Callaway Agency,
        from 2016 to 2024, and in real estate since 2016, first as a licensed
        realtor with Weichert and since 2021 as a relocation specialist with
        License Park Realty.
      </p>
    </section>

    <section aria-labelledby="education-heading">
      <h2 id="education-heading">Education</h2>
      <ul class="education">
        <li>
          <strong>University of Maryland Global Campus.</strong> Master of
          Science in Technology Management.
        </li>
        <li>
          <strong>University of Maryland, College Park.</strong> Bachelor of
          Arts in History and American Studies, with focus areas in
          Psychology and Sociology.
        </li>
      </ul>
    </section>

    <section aria-labelledby="ai-heading">
      <h2 id="ai-heading">Technology and AI</h2>
      <p>
        I've worked alongside technical teams throughout my career,
        translating complex requirements into plans, documentation,
        decisions, and experiences that people can use.
      </p>
      <p>
        Today, AI is part of that toolkit. I use it to explore ideas, create
        working prototypes, accelerate documentation, support analysis, and
        build digital experiences. My focus is on applying the technology
        thoughtfully, with clear requirements, appropriate review, and
        accountability for the finished work.
      </p>
      <p>
        This portfolio is one example of that approach, combining my own
        strategy, content direction, design decisions, and hands-on iteration
        with AI-assisted development.
      </p>
    </section>
  </div>
</Base>

<style>
  .page-intro {
    padding-block-start: var(--space-48);
  }

  .page-intro p {
    margin-top: var(--space-16);
    font-size: var(--size-subhead);
    color: var(--muted);
    max-width: 60ch;
  }

  .headshot {
    margin-top: var(--space-24);
    width: 200px;
  }

  .headshot img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-card);
  }

  section {
    margin-top: var(--space-48);
  }

  section p + p {
    margin-top: var(--space-16);
  }

  h2 {
    margin-bottom: var(--space-16);
  }

  /* The portrait botanical sits beside the six approach items; at phone
     width it follows them. */
  .approach-section {
    display: grid;
    gap: var(--space-32);
    align-items: start;
  }

  .approach-art img {
    border-radius: var(--radius-card);
  }

  .approach {
    display: grid;
    gap: var(--space-16);
  }

  .approach-item {
    padding-top: var(--space-16);
    border-top: 1px solid var(--border);
  }

  .approach-item dt {
    font-weight: 500;
  }

  .approach-item dd {
    margin-top: var(--space-4);
    color: var(--muted);
    font-size: var(--size-small);
    line-height: 1.5;
  }

  .timeline {
    list-style: none;
    padding: 0;
    margin-top: var(--space-24);
  }

  .timeline-item {
    display: grid;
    gap: var(--space-4) var(--space-24);
    padding-block: var(--space-16);
    border-top: 1px solid var(--border);
  }

  /* Both selectors are needed to outrank the generic `section p + p`
     spacing rule above once Astro scopes them. */
  .timeline-item p,
  .timeline-item p + p {
    margin: 0;
  }

  .timeline-years {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--size-eyebrow);
    color: var(--muted);
  }

  .timeline-title {
    font-weight: 500;
  }

  .timeline-org {
    font-size: var(--size-small);
  }

  .parallel,
  .education {
    margin-top: var(--space-24);
    color: var(--muted);
  }

  .education {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-12);
  }

  .education strong {
    font-weight: 500;
    color: var(--text);
  }

  .timeline-item p + p.timeline-note {
    margin-top: var(--space-4);
    font-size: var(--size-small);
    color: var(--muted);
    line-height: 1.5;
  }

  @media (min-width: 768px) {
    .page-intro {
      display: grid;
      grid-template-columns: 1fr 200px;
      gap: var(--space-16) var(--space-48);
      align-items: start;
    }

    .page-intro h1 {
      grid-column: 1;
    }

    .page-intro p {
      grid-column: 1;
    }

    .headshot {
      grid-column: 2;
      grid-row: 1 / 3;
      margin-top: 0;
    }

    .approach-section {
      grid-template-columns: 1fr 260px;
      gap: var(--space-48);
    }

    .approach-art {
      margin-top: var(--space-48);
    }

    .timeline-item {
      grid-template-columns: 180px 1fr;
    }
  }

  @media (min-width: 1024px) {
    .page-intro {
      padding-block-start: var(--space-64);
    }

    section {
      margin-top: var(--space-64);
    }

    .approach-section {
      grid-template-columns: 1fr 300px;
      gap: var(--space-64);
    }
  }
</style>
